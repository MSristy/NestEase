# --- Server Configuration ---
PORT=3001
NODE_ENV=production

# --- Database Configuration (Aiven - Updated with your Info) ---
DB_TYPE=mysql
DB_HOST=mysql-1bbeb89f-nestease221.c.aivencloud.com
DB_PORT=10940
DB_USERNAME=avnadmin
DB_PASSWORD=AVNS_5R4qpAlKh_yntxalKHN
DB_DATABASE=defaultdb
DB_SSL=true

# নোট: কিছু ফাইলে DB_NAME ব্যবহার করা হয়েছে, তাই সেইফ থাকার জন্য এটিও রাখা হলো
DB_NAME=defaultdb

# --- JWT Authentication (অবশ্যই পরিবর্তন করবেন) ---
# এখানে একটি লম্বা ও কঠিন পাসওয়ার্ড দিন (যেমন: aKj8#s9L!2dF...)
JWT_SECRET=change_this_to_a_super_secret_random_string
JWT_EXPIRATION=24h

# --- CORS Configuration ---
# আপনার Vercel ফ্রন্টএন্ডের লিংক এখানে দেবেন। আপাতত * (সবাই) দেওয়া হলো।
CORS_ORIGIN=*

# --- Applink SMS API (হ্যাকাথনের ক্রেডেনশিয়াল বসান) ---
APPLINK_API_URL=https://dev.applink.com.bd
APPLINK_SOURCE_ADDRESS=NESTEASE
# নিচের দুটি হ্যাকাথন থেকে পাওয়া তথ্য দিয়ে পূরণ করুন
APPLINK_APPLICATION_ID=your_applink_id_here
APPLINK_PASSWORD=your_applink_password_here

# --- Email Configuration (Nodemailer) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# জিমেইল ব্যবহার করলে আপনার ইমেইল এবং অ্যাপ পাসওয়ার্ড দিন
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-email-app-password
EMAIL_FROM=noreply@nestease.com

# --- Payment Gateway (Stripe) ---
STRIPE_SECRET_KEY=sk_test_your_stripe_key_here
STRIPE_CURRENCY=usd

# --- Others ---
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX=100